# Standalone Clerk authentication and exact browser origins
CORS_ORIGINS=http://localhost:5173
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=polytrade

# Optional: allow AssetHero's separate identity system to call PolyTrade APIs.
# Configure issuer and JWKS together; leave both empty until the integration is enabled.
ASSETHERO_API_ISSUER=
ASSETHERO_API_JWKS_URL=
ASSETHERO_API_AUDIENCE=polytrade

# One existing remote PostgreSQL database and one application setting. All services use it.
# Use the provider's TLS-enabled connection URL; this example value is not deployable.
DATABASE_URL=postgresql://polytrade:replace-me@db.example.com:5432/polytrade?sslmode=require

# Redis carries Celery jobs and short-lived status only; PostgreSQL is authoritative.
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/1
BACKTEST_WORKER_CONCURRENCY=2
BACKTEST_MAX_ACTIVE_RUNS_PER_OWNER=10
BACKTEST_MAX_RETRIES=5
BACKTEST_SOFT_TIME_LIMIT_SECONDS=840
BACKTEST_HARD_TIME_LIMIT_SECONDS=900
BACKTEST_VISIBILITY_TIMEOUT_SECONDS=1200
BACKTEST_STALE_SECONDS=960
BACKTEST_OUTBOX_INTERVAL_SECONDS=2
BACKTEST_MAX_POINTS=2000000
POLYMARKET_REQUEST_TIMEOUT_SECONDS=15

# Agent
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GATEWAY_BASE_URL=http://localhost:4000
BACKTEST_BASE_URL=http://localhost:8100
# Exactly 32 ASCII bytes; generate with: openssl rand -hex 16
LANGGRAPH_AES_KEY=
AGENT_HTTP_TIMEOUT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MAX_CONCURRENT_RUNS=8
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_THREAD_TTL_DAYS=30
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Gateway
NODE_ENV=development
PORT=4000
AGENT_UPSTREAM_URL=http://localhost:8000
BACKTEST_UPSTREAM_URL=http://localhost:8100
UPSTREAM_PROXY_TIMEOUT_MS=60000
# Generate with: openssl rand -base64 32
CREDENTIALS_KEK_BASE64=
# Optional: bot token for Telegram alert channels (from @BotFather). Leave empty
# until a Telegram alert channel is configured.
TELEGRAM_BOT_TOKEN=
TRUSTED_PROXIES=127.0.0.1/32,::1/128
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_REQUEST_TIMEOUT_MS=10000
WALLET_CHALLENGE_TTL_SECONDS=300
# Idle window slides forward while the tab is visible; absolute caps custody at one day.
WALLET_SESSION_IDLE_SECONDS=14400
WALLET_SESSION_MAX_SECONDS=86400
ORDER_INTENT_TTL_SECONDS=120

# React/Vite standalone Clerk client
VITE_API_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=polytrade

# --- Legacy chat stack (docker-compose.chat.yaml) ---
# Vars used only by the legacy PolyTrade Chat deployment. The paper platform
# ignores them; keep them here so both stacks can deploy from this repo.
MODEL=gpt-4.1-mini
MODEL_PROVIDER=openai
AGENT_FRAMEWORK=deepagents
HERMES_IMAGE_TAG=v2026.7.7.2
HERMES_API_URL=http://hermes:8642/v1
HERMES_API_SERVER_KEY=
HERMES_API_MODEL=hermes-agent
HERMES_API_TIMEOUT_SECONDS=180
HERMES_MAX_ITERATIONS=20
HERMES_PERSIST_SESSIONS=true
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_MAP={}
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_USER_MAP={}
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
FINANCIAL_DATA_PROVIDER=financial_datasets
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
MASSIVE_API_KEY=your-massive-api-key
TAVILY_API_KEY=your-tavily-api-key
OLLAMA_BASE_URL=http://127.0.0.1:11434
POLYMARKET_WALLET_PRIVATE_KEY=your-private-key-here
POLYGON_RPC_URL=https://polygon-rpc.com
TOMORROWIO_API_KEY=your-tomorrowio-api-key
VISUAL_CROSSING_API_KEY=your-visual-crossing-api-key
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=
JWT_ISSUER=polytrade
JWT_AUDIENCE=polytrade-api
ASSETHERO_CLIENT_ID=assethero
ASSETHERO_CLIENT_SECRET=
ASSETHERO_SERVICE_USER_ID=
SERVICE_TOKEN_TTL_SECONDS=900
SERVICE_AUTH_RATE_LIMIT_PER_MINUTE=10
SERVICE_CHAT_RATE_LIMIT_PER_MINUTE=120
CHAT_MAX_MESSAGE_CHARS=20000
CHAT_MAX_HISTORY_MESSAGES=50
CHAT_MAX_CONCURRENT_RUNS=8
CHAT_RUN_TIMEOUT_SECONDS=300
CHAT_STALE_RUN_SECONDS=600
CHAT_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_SSE_HEARTBEAT_SECONDS=15
POSTMARK_API_KEY=your-postmark-api-key
FROM_EMAIL=noreply@polytrade.chat
POLYCODE_DB_URL=postgresql://user:pass@host:5432/dbname
CHAT_REQUIRE_DATABASE=true
POLYCODE_DEBUG=false
WEB_RELOAD=false
# Note: CORS_ORIGINS is shared. The paper platform expects the web app origin
# (e.g. https://polytrade.chat); the chat stack used ports 4002/4003 locally.
