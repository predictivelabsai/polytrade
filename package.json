{
  "name": "polytrade",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.18.1"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.21.1",
      "fast-uri@3": "3.1.6",
      "fast-uri@4": "4.1.3"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:agent": "uv run --project services/agent uvicorn polytrade_agent.server:app --host 0.0.0.0 --port 8000 --reload",
    "dev:backtest": "uv run --project services/backtest uvicorn polytrade_backtest.server:app --host 0.0.0.0 --port 8100 --reload",
    "dev:backtest-worker": "uv run --project services/backtest celery --app=polytrade_backtest.celery_app:celery_app worker --loglevel=INFO",
    "dev:gateway": "pnpm --filter @polytrade/gateway dev",
    "dev:web": "pnpm --filter @polytrade/web dev",
    "lint": "pnpm --filter @polytrade/contracts build && pnpm -r lint",
    "test": "pnpm --filter @polytrade/contracts build && pnpm -r test",
    "test:agent": "uv run --project services/agent pytest -q services/agent/tests",
    "test:backtest": "uv run --project services/backtest pytest -q services/backtest/tests",
    "typecheck": "pnpm --filter @polytrade/contracts build && pnpm -r typecheck"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
