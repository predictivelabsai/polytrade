# LLM Provider Configuration
MODEL=gpt-4.1-mini
MODEL_PROVIDER=openai
AGENT_FRAMEWORK=deepagents

# Hermes sidecar (keep the service private; store the real key in deployment secrets)
HERMES_IMAGE_TAG=v2026.7.7.2
HERMES_API_URL=http://hermes:8642/v1
HERMES_API_SERVER_KEY=
HERMES_API_MODEL=hermes-agent
HERMES_API_TIMEOUT_SECONDS=180
HERMES_MAX_ITERATIONS=20
HERMES_PERSIST_SESSIONS=true

# Messaging channels. Map immutable provider IDs to Polytrade user UUIDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_MAP={}
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_USER_MAP={}

# API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key

# Financial Data (Options: massive, financial_datasets)
FINANCIAL_DATA_PROVIDER=financial_datasets
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
MASSIVE_API_KEY=your-massive-api-key

# Web Search (Optional)
TAVILY_API_KEY=your-tavily-api-key

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- POLYMARKET REAL TRADING CONFIGURATION ---
# ONLY your Private Key is required. The bot automatically discovers your proxy
# and derives API credentials on-the-fly.

# Your Polygon wallet private key (starts with 0x...)
# It can be exported in Polymarket web-app
POLYMARKET_WALLET_PRIVATE_KEY=your-private-key-here

# Optional: Custom RPC URL (defaults to public endpoint if empty)
POLYGON_RPC_URL=https://polygon-rpc.com

# [ADVANCED] Optional Overrides (Leave commented for auto-setup)
# POLYMARKET_PROXY_ADDRESS=
# POLYMARKET_API_KEY=
# POLYMARKET_SECRET=
# POLYMARKET_PASSPHRASE=
# POLYMARKET_SIGNATURE_TYPE=1

# Weather APIs
TOMORROWIO_API_KEY=...
VISUAL_CROSSING_API_KEY=...

# Auth & Sessions
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=polytrade
JWT_AUDIENCE=polytrade-api

# AssetHero service-to-service auth (API container only)
ASSETHERO_CLIENT_ID=assethero
ASSETHERO_CLIENT_SECRET=
# Optional stable UUID override; leave empty to derive one from ASSETHERO_CLIENT_ID
ASSETHERO_SERVICE_USER_ID=
SERVICE_TOKEN_TTL_SECONDS=900
SERVICE_AUTH_RATE_LIMIT_PER_MINUTE=10
SERVICE_CHAT_RATE_LIMIT_PER_MINUTE=120

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:4002,http://localhost:4003

# Shared chat limits
CHAT_MAX_MESSAGE_CHARS=20000
CHAT_MAX_HISTORY_MESSAGES=50
CHAT_MAX_CONCURRENT_RUNS=8
CHAT_RUN_TIMEOUT_SECONDS=300
CHAT_STALE_RUN_SECONDS=600
CHAT_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_SSE_HEARTBEAT_SECONDS=15

# Email (Postmark — for password reset emails)
POSTMARK_API_KEY=your-postmark-api-key
FROM_EMAIL=noreply@polytrade.chat

# Database (required for durable, cross-process chat history)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
POLYCODE_DB_URL=postgresql://user:pass@host:5432/dbname
CHAT_REQUIRE_DATABASE=true

# Debug Mode
POLYCODE_DEBUG=false
WEB_RELOAD=false
